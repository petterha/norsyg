at-comp_rule := arg0e_gtr &
 [ CONTEXT.RELS <! [ PRED 2cp ], [ PRED "subord_rel" ] !>,
   FLAGS.TRIGGER "at-comp" ].

inf-comp_rule := arg0e_gtr &
 [ CONTEXT.RELS <! [ PRED inf+ ] !>,
   FLAGS.TRIGGER "inf-comp" ].

