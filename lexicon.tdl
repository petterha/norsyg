;;; lexical entries for the vpidiom paper (2014-04-15; ph)

bringe_v := main-verb-lxm &
  [ STEM < "bringe" >,
    INFLECTION v1,
    SYNSEM.LKEYS.KEYREL.PRED bringe_v ].

løfte_v := main-verb-lxm &
  [ STEM < "løfte" >,
    INFLECTION v1,
    SYNSEM.LKEYS.KEYREL.PRED løfte_v ].

på_prp := prep-word &
  [ STEM < "på" >,
    SYNSEM.LKEYS.KEYREL.PRED på_prp ].

på_prt := part-word &
  [ STEM < "på" >,
    SYNSEM.LKEYS.KEYREL.PRED på_prt ].

på-lenge_adv := adv-word &
  [ STEM < "på","lenge" >,
    SYNSEM.LKEYS.KEYREL.PRED _på*lenge_adv_rel ].

påstand-n-masc := masc-mwe-count-noun-lxm &
  [ STEM < "påstand" >,
    INFLECTION m1,
    SYNSEM.LKEYS.KEYREL.PRED påstand_prd ].

