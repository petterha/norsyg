    SYNSEM.LKEYS.KEYREL.PRED til_prt ].

til_adv := adv-word &
  [ STEM < "til" >,
    SYNSEM.LKEYS.KEYREL.PRED _til_adv_rel ].

til_cadv := cadv-word &
  [ STEM < "til" >,
