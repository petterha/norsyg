  [ STEM < "sØ", "for" >,
    SYNSEM.LKEYS.KEYREL.PRED sØ*for_prp ].

så*da_ij := interj-word &
  [ STEM < "så", "da" >,
    SYNSEM.LKEYS.KEYREL.PRED så*da_prd ].

så*godt*som_degadv := degadv-word &
  [ STEM < "så", "godt", "som" >,
    SYNSEM.LKEYS.KEYREL.PRED så*godt*som_prd ].

så*langt_sadv := sadv-word &
  [ STEM < "så", "langt" >,
    SYNSEM.LKEYS.KEYREL.PRED _så*langt_sadv_rel ].

så*lenge_cadv := cadv-word &
  [ STEM < "så", "lenge" >,
    SYNSEM.LKEYS.KEYREL.PRED _så*lenge_x_rel ].

så*og*si_sadv := sadv-word &
  [ STEM < "så", "og", "si" >,
    SYNSEM.LKEYS.KEYREL.PRED _så*og*si_sadv_rel ].

så*pass_adv := adv-word &
  [ STEM <"så","pass">,
    SYNSEM.LKEYS.KEYREL.PRED _så*pass_adv_rel ].

så*snart_cadv := cadv-word &
  [ STEM < "så", "snart" >,
    SYNSEM.LKEYS.KEYREL.PRED _så*snart_x_rel ].

så*vel*som_prp := prep-word &
  [ STEM < "så", "vel", "som" >,
    SYNSEM.LKEYS.KEYREL.PRED så*vel*som_prp ].

så*vidt_sadv := sadv-word &
  [ STEM < "så", "vidt" >,
